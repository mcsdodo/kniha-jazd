# =============================================================================
# Stage 1: Build the Rust web binary
# =============================================================================
FROM rust:1.86-bookworm AS rust-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/src-tauri

# Copy manifests only, plus stub sources for the two workspace members.
# This makes the dependency build below cacheable: Cargo sees the real
# Cargo.toml/Cargo.lock (so it resolves and compiles every dependency) but a
# trivial lib.rs/main.rs, so the layer only busts when a manifest or the lock
# file changes -- NOT when core/ or web/ source changes.
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./
COPY src-tauri/core/Cargo.toml ./core/Cargo.toml
COPY src-tauri/web/Cargo.toml ./web/Cargo.toml
RUN mkdir -p core/src web/src \
    && echo '' > core/src/lib.rs \
    && echo 'fn main() {}' > web/src/main.rs

# Compile all dependencies (and the stub crates) in a layer keyed only on the
# manifests + toolchain. If a manifest or Cargo.lock changes this rebuilds;
# otherwise it is reused verbatim on every source-only change.
RUN cargo build --release -p kniha-jazd-web \
    && rm -rf core/src web/src

# Real sources. Only kniha-jazd-core and kniha-jazd-web recompile; every
# dependency stays cached from the layer above.
COPY src-tauri/core ./core
COPY src-tauri/web ./web
# The touch is load-bearing: it is what defeats the cached stub layer. Cargo
# decides by fingerprint, and a COPY can land a source file whose mtime is older
# than the stub .rlib built above (an old working tree, a local build), in which
# case cargo considers the crate fresh and ships a binary built from the stubs.
# Touching both crate roots forces the rebuild. Do not remove it.
RUN touch core/src/lib.rs web/src/main.rs \
    && cargo build --release -p kniha-jazd-web

# =============================================================================
# Stage 2: Build the SvelteKit static frontend
# =============================================================================
FROM node:20-alpine AS node-builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY svelte.config.js vite.config.ts tsconfig.json ./
COPY src ./src
COPY static ./static
RUN npm run build

# =============================================================================
# Stage 3: Minimal runtime image
# =============================================================================
FROM debian:bookworm-slim
# Headless web binary — depends only on kniha-jazd-core, no GUI runtime libs needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-builder /app/src-tauri/target/release/kniha-jazd-web /usr/local/bin/kniha-jazd-web
COPY --from=node-builder /app/build /var/www/html

RUN mkdir -p /data

ENV DATABASE_PATH=/data/kniha-jazd.db \
    KNIHA_JAZD_DATA_DIR=/data \
    STATIC_DIR=/var/www/html \
    PORT=3456

VOLUME ["/data"]
EXPOSE 3456

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fs http://localhost:3456/health || exit 1

CMD ["kniha-jazd-web"]
